    {
      "id": "4d3c5e59041a49dd9a4a",
      "type": "text",
      "x": 96,
      "y": 1564,
      "width": 1968,
      "height": 102,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2110824149,
      "version": 2,
      "versionNonce": 1961735104,
      "isDeleted": false,
      "text": "GMFCS И ВОЗРАСТ\n\nGMFCS может быть ориентиром для родителя при оценке общих функциональных возможностей с учётом возраста. Он не заменяет функциональный опросник и не является допуском к тренировке. Не усложняем вход, если классификация не меняет подбор упражнений.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GMFCS И ВОЗРАСТ\n\nGMFCS может быть ориентиром для родителя при оценке общих функциональных возможностей с учётом возраста. Он не заменяет функциональный опросник и не является допуском к тренировке. Не усложняем вход, если классификация не меняет подбор упражнений.",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 17,
      "updated": 1794230420654,
      "link": null,
      "locked": false,
      "index": "al",
      "boundElements": [],
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
