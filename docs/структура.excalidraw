    {
      "id": "cqByPKhPNDze-8oBlmIXV",
      "type": "text",
      "x": 7681.092403944113,
      "y": 1044.779059180588,
      "width": 206.5760040283203,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3Y",
      "roundness": null,
      "seed": 360177779,
      "version": 224,
      "versionNonce": 1458921149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795181426211,
      "created": 1795181325808,
      "link": null,
      "locked": false,
      "text": "Я бы хотела, чтобы\nчеловек отмечал \"На\nсколько трудно мне было\"\nпосле тренировки в общем\n(если она из нескольких\nупражнений) или если\nребенок делает одно\nупражнение, то после него",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ARXtfECkU830iEtZB6UVx",
      "originalText": "Я бы хотела, чтобы человек отмечал \"На сколько трудно мне было\" после тренировки в общем (если она из нескольких упражнений) или если ребенок делает одно упражнение, то после него",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bjF5tVkBI0UNMyMYIkCCZ",
      "type": "stickynote",
      "x": 7837.606618928854,
      "y": 817.4396841502565,
      "width": 237.16974308959513,
      "height": 176.89888428464877,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3Z",
