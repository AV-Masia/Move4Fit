      "boundElements": [],
      "updated": 1795181273133,
      "created": 1795181251487,
      "link": null,
      "locked": false,
      "text": "Оценка тоже\nскорее\nхотелось бы,\nчтобы\nвысвечивалась\nмордочками",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "-bFHFHy3m8A12Eeq0_JyA",
      "originalText": "Оценка тоже скорее хотелось бы, чтобы высвечивалась мордочками",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
