    {
      "id": "uW0mIXdHuctgM4MuHJv_Q",
      "type": "text",
      "x": 10102.041918509618,
      "y": -212.41570106659924,
      "width": 165.52000427246094,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
