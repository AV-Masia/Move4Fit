      "seed": 459622464,
      "version": 4,
      "versionNonce": 1063200832,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794232231064,
      "created": 1794232226143,
      "link": null,
      "locked": false,
      "text": "Затем из библиотеки\nвыбираем\nупражнения на силу,\nдоступные в этих\nположениях и с\nподходящим уровнем\nопоры.",
      "fontSize": 26,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "OJhj2houfHjUfoUWB4Jp2",
      "originalText": "Затем из библиотеки выбираем упражнения на силу, доступные в этих положениях и с подходящим уровнем опоры.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eWtPeRsuNXUAFO318b7V2",
      "type": "stickynote",
      "x": 1288.9041397787307,
      "y": 2023.2634113696795,
      "width": 288.0106909568483,
      "height": 288.0106909568483,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffd8a8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
