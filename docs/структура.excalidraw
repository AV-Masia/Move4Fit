    },
    {
      "id": "5e5793f10a4a4636b8f9",
      "type": "text",
      "x": 1416,
      "y": 804,
      "width": 648,
      "height": 302,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1167154837,
      "version": 2,
      "versionNonce": 2067108800,
      "isDeleted": false,
      "text": "НАБЛЮДЕНИЯ РОДИТЕЛЯ\n\n• Получилось ли выполнить упражнение?\n• Нужна ли была помощь или дополнительная поддержка?\n• Были ли необычная усталость, дискомфорт или тревожные симптомы?\n• Были ли понятны инструкция и видео?\n\nСложность, утомление и желание продолжать — разные показатели. Лёгкость сама по себе не означает, что нужно повышать нагрузку.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "НАБЛЮДЕНИЯ РОДИТЕЛЯ\n\n• Получилось ли выполнить упражнение?\n• Нужна ли была помощь или дополнительная поддержка?\n• Были ли необычная усталость, дискомфорт или тревожные симптомы?\n• Были ли понятны инструкция и видео?\n\nСложность, утомление и желание продолжать — разные показатели. Лёгкость сама по себе не означает, что нужно повышать нагрузку.",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 17,
      "updated": 1794230420654,
      "link": null,
      "locked": false,
      "index": "ad",
      "boundElements": [],
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "26b49c8ed7ba40c3b269",
