      "id": "EKcy9t84FPasrqmc4qxU9",
      "type": "stickynote",
      "x": 7983.978704598009,
      "y": 1025.6481054764345,
      "width": 182.37805326691614,
      "height": 182.37805326691614,
      "angle": 0,
      "strokeColor": "#1e1e1e",
