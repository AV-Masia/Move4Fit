    {
      "id": "H42mdZTGCixs4mberT97T",
      "type": "text",
      "x": 1309.801491177565,
      "y": 2062.2687568481037,
      "width": 246.2159881591797,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
