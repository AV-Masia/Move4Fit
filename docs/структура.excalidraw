    {
      "id": "ikPSebkGcRvKM_elSTiw_",
      "type": "text",
      "x": 1687.3715049369935,
      "y": 2065.0587212115806,
      "width": 245.66397094726562,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02V",
      "roundness": null,
      "seed": 275012544,
      "version": 4,
      "versionNonce": 947420096,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794232308709,
      "created": 1794232303745,
      "link": null,
      "locked": false,
      "text": "Если ребёнок не может\nбезопасно перейти на пол и\nобратно, исключаем\nупражнения, требующие\nтакого перехода, но не\nисключаем автоматически\nвсе упражнения на полу,\nесли можно организовать\nбезопасный доступ.",
      "fontSize": 18,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "CANQeB-s7szQ4TuBlfTwu",
      "originalText": "Если ребёнок не может безопасно перейти на пол и обратно, исключаем упражнения, требующие такого перехода, но не исключаем автоматически все упражнения на полу, если можно организовать безопасный доступ.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
