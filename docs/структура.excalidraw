      "updated": 1795181592358,
      "created": 1795181569781,
      "link": null,
      "locked": false,
      "text": "Возможно такой\nвопрос может быть\nи до тренировки",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "EKcy9t84FPasrqmc4qxU9",
      "originalText": "Возможно такой вопрос может быть и до тренировки",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
