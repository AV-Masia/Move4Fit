    {
      "id": "73497899c00240baa39a",
      "type": "text",
      "x": 756,
      "y": 804,
      "width": 588,
      "height": 302,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1390981865,
      "version": 2,
      "versionNonce": 1229786048,
      "isDeleted": false,
      "text": "ОБРАТНАЯ СВЯЗЬ РЕБЁНКА\n\nСложность: легко / нормально, пришлось постараться / очень трудно.\n\nУсталость: не устал(а) / немного / очень.\n\nЧто дальше: продолжить / отдохнуть / закончить на сегодня.\n\nДля детей, которым трудно отвечать словами, предусмотреть визуальные варианты.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ОБРАТНАЯ СВЯЗЬ РЕБЁНКА\n\nСложность: легко / нормально, пришлось постараться / очень трудно.\n\nУсталость: не устал(а) / немного / очень.\n\nЧто дальше: продолжить / отдохнуть / закончить на сегодня.\n\nДля детей, которым трудно отвечать словами, предусмотреть визуальные варианты.",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 17,
      "updated": 1794230420654,
      "link": null,
      "locked": false,
      "index": "ab",
      "boundElements": [],
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "5a3ad2b1ebdc4013b199",
      "type": "rectangle",
