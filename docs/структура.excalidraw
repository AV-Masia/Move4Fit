    },
    {
      "id": "jM61zAcMPFISBAX35yJS9",
      "type": "text",
      "x": 7853.623489680194,
      "y": 838.3385684349053,
      "width": 205.13600158691406,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3ZV",
      "roundness": null,
      "seed": 977748317,
      "version": 261,
      "versionNonce": 473712861,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795181558581,
      "created": 1795181454406,
      "link": null,
      "locked": false,
      "text": "После кнопки \"Закончить\nтренировку\", я бы хотела,\nчтобы был вопрос \"Как ты\nсебя сейчас чувствуешь\" и\nсделать разных иконок:\nсупер мэн, ленивец и тд...",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "bjF5tVkBI0UNMyMYIkCCZ",
      "originalText": "После кнопки \"Закончить тренировку\", я бы хотела, чтобы был вопрос \"Как ты себя сейчас чувствуешь\" и сделать разных иконок: супер мэн, ленивец и тд...",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
