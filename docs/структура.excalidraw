    },
    {
      "id": "AsG0Xn75bZGLIecHN_ZZd",
      "type": "text",
      "x": 565.9901305597695,
      "y": 2059.208364846352,
      "width": 261.14404296875,
      "height": 195,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "avV",
      "roundness": null,
      "seed": 143575104,
      "version": 12,
      "versionNonce": 1986816064,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794232187402,
      "created": 1794232179255,
      "link": null,
      "locked": false,
      "text": "Сначала\nопределяем, какие\nисходные положения\nи переходы ребёнок\nможет выполнять\nбезопасно",
      "fontSize": 26,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "o4U-2UmiQ4QvgeS3kyCvk",
      "originalText": "Сначала определяем, какие исходные положения и переходы ребёнок может выполнять безопасно",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "OJhj2houfHjUfoUWB4Jp2",
      "type": "stickynote",
      "x": 937.5310968113741,
      "y": 2017.5031975505422,
      "width": 295.69097604903106,
      "height": 295.69097604903106,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": {
        "type": 2
      },
